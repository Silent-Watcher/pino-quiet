{
	"name": "pino-quiet",
	"version": "1.0.1",
	"description": "A lightweight pino transport that collapses repeated consecutive log messages.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"dist",
		"readme.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"keywords": [
		"pino",
		"transport",
		"log",
		"logging",
		"deduplicate",
		"dedupe",
		"noise",
		"quiet",
		"pino-pretty",
		"pipeline"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Silent-Watcher/pino-quiet"
	},
	"bugs": {
		"url": "https://github.com/Silent-Watcher/pino-quiet/issues"
	},
	"homepage": "https://github.com/Silent-Watcher/pino-quiet#readme",
	"author": {
		"email": "backendwithali@gmail.com",
		"name": "Ali nazari"
	},
	"scripts": {
		"tsc": "tsc",
		"dev": "node --watch src/index.ts",
		"prebuild": "npm run tsc && npm run clean",
		"build": "tsup",
		"prestart": "npm run build",
		"start": "node dist/index.js",
		"pretest": "npm run build",
		"test": "vitest run --coverage",
		"test:pack": "node scripts/pack-smoke.mjs",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"test:watch": "vitest dev",
		"prelint": "biome format --write ./src/*.ts ./tests/*.ts",
		"lint": "biome lint ./src/*.ts ./tests/*.ts",
		"check": "biome check --write ./src/*.ts ./tests/*.ts",
		"prepare": "husky",
		"commit": "cz",
		"clean": "del-cli dist/ coverage/ *.log",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.0.14",
		"cz-conventional-changelog": "^3.3.0",
		"del-cli": "^7.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"pino": "^10.1.0",
		"pino-pretty": "^13.2.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitepress": "^1.6.4",
		"vitest": "^4.0.14"
	},
	"peerDependencies": {
		"pino": "^9.0.0 || ^10.0.0"
	},
	"dependencies": {
		"fast-deep-equal": "^3.1.3",
		"pino-abstract-transport": "^3.0.0",
		"sonic-boom": "^4.2.0"
	},
	"allowScripts": {
		"esbuild@0.27.0": true,
		"esbuild@0.25.12": true
	}
}
